+  void D3D9DeviceEx::TryExtractProjectionFromVSConstants(
+          UINT   StartRegister,
+    const float* pConstantData,
+          UINT   Vector4fCount) {
+    // Need at least 4 consecutive float4 registers to form a 4x4 matrix
+    if (Vector4fCount < 4 || StartRegister + Vector4fCount > 32)
